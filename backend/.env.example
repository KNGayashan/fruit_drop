PORT=3000

# The backend now serves the game frontend itself (same origin), so
# CORS_ORIGIN mainly matters if something else calls the API cross-origin
# (e.g. a separately-hosted copy of the frontend). Set it to that origin;
# otherwise the default is harmless.
CORS_ORIGIN=http://localhost:8000

# Long random string used to sign admin session tokens
JWT_SECRET=change_me_to_a_long_random_string

# Admin login is created on first run via the /admin/ dashboard's
# setup screen — no credentials belong in this file.
